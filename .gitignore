# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local artifacts
FRONTEND SCREENING TASK.pdf
.env.local
assets/ui
graphify-out
# task docs ship as PDFs; Markdown sources and the PDF build stay local
assets/docs/*.md
assets/docs/build-pdfs.sh
assets/docs/.build/
